index eef78b6..bcea210 100644
--- a/.github/workflows/build-cross.yml
+++ b/.github/workflows/build-cross.yml
@@ -315,3 +315,68 @@ jobs:
                          -DCMAKE_TOOLCHAIN_FILE=${PWD}/cmake/riscv64-spacemit-linux-gnu-gcc.cmake
 
           cmake --build build --config Release -j $(nproc)
+
+  ubuntu-24-riscv64-cpu-mips-p8700-cross:
+    runs-on: ubuntu-24.04
+
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Setup toolchain and emulator
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+                  gcc-14-riscv64-linux-gnu \
+                  g++-14-riscv64-linux-gnu \
+                  qemu-user-static
+
+      - name: Build
+        run: |
+          # The P8700 is RV64GC_Zba_Zbb - no vector unit, no Zfh/Zvfh, and it
+          # provides Xmipscbop rather than Zicbop.
+          cmake -B build -DLLAMA_OPENSSL=OFF \
+                         -DCMAKE_BUILD_TYPE=Release \
+                         -DGGML_OPENMP=OFF \
+                         -DLLAMA_BUILD_EXAMPLES=OFF \
+                         -DLLAMA_BUILD_TOOLS=OFF \
+                         -DLLAMA_BUILD_TESTS=ON \
+                         -DGGML_RVV=OFF \
+                         -DGGML_RV_ZFH=OFF \
+                         -DGGML_RV_ZVFH=OFF \
+                         -DGGML_RV_ZICBOP=OFF \
+                         -DGGML_RV_ZBA=ON \
+                         -DGGML_RV_ZBB=ON \
+                         -DRISCV_TOOLCHAIN_SUFFIX=-14 \
+                         -DCMAKE_TOOLCHAIN_FILE=${PWD}/cmake/riscv64-mips-p8700-linux-gnu-gcc.cmake
+
+          cmake --build build --config Release -j $(nproc) \
+                  -t test-quantize-fns test-rope test-barrier
+
+      - name: Check Zbb codegen
+        run: |
+          # Fail loudly if -march never reached the compiler: the quantization
+          # hot paths must contain Zbb instructions.
+          CPU_LIB=$(find build -name 'libggml-cpu.*' -o -name '*ggml-cpu*.o' | head -n 1)
+          test -n "$CPU_LIB"
+          echo "disassembling $CPU_LIB"
+          riscv64-linux-gnu-objdump -d "$CPU_LIB" > /tmp/ggml-cpu.asm
+          ZBB=$(grep -cE '[[:space:]](min|max|minu|maxu|cpop|cpopw|clz|clzw|ctz|ctzw|sext\.b|sext\.h|zext\.h|andn|orn|xnor|rev8|orc\.b|rol|rolw|ror|rorw|rori|roriw)[[:space:]]' \
+                  /tmp/ggml-cpu.asm || true)
+          echo "Zbb instructions: $ZBB"
+          test "$ZBB" -gt 0
+
+      - name: Test
+        run: |
+          # QEMU >= 10 models the P8700 directly via `-cpu mips-p8700`; the
+          # runner image ships an older qemu, so spell out the same ISA instead.
+          #
+          # test-backend-ops is not useful here: its default mode skips the CPU
+          # backend when CPU is the only device, and `grad` mode does not finish
+          # in reasonable time under emulation. test-quantize-fns is the
+          # targeted check anyway - it covers the scalar vec_dot paths, which is
+          # where the Zbb codegen lands on a core without a vector unit.
+          export QEMU="qemu-riscv64-static -L /usr/riscv64-linux-gnu -cpu rv64,v=false,zba=true,zbb=true"
+          export LD_LIBRARY_PATH=${PWD}/build/bin
+          $QEMU ./build/bin/test-quantize-fns
+          $QEMU ./build/bin/test-rope
+          $QEMU ./build/bin/test-barrier
diff --git a/cmake/riscv64-mips-p8700-linux-gnu-gcc.cmake b/cmake/riscv64-mips-p8700-linux-gnu-gcc.cmake
new file mode 100644
index 0000000..090456f
--- /dev/null
+++ b/cmake/riscv64-mips-p8700-linux-gnu-gcc.cmake
@@ -0,0 +1,48 @@
+# Toolchain file for the MIPS P8700, a RISC-V core implementing RV64GC_Zba_Zbb.
+#
+# The P8700 has no vector unit, so builds using this file must also pass
+# -DGGML_RVV=OFF (see docs/build.md).
+#
+# By default this uses the distribution cross toolchain (riscv64-linux-gnu-*).
+# Set RISCV_ROOT_PATH to use a standalone riscv64-unknown-linux-gnu toolchain
+# instead, e.g. one built with MIPS vendor extension support.
+
+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_PROCESSOR riscv64)
+set(CMAKE_SYSTEM_VERSION 1)
+
+if (CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(riscv)")
+    message(STATUS "HOST SYSTEM ${CMAKE_HOST_SYSTEM_PROCESSOR}")
+elseif (DEFINED ENV{RISCV_ROOT_PATH})
+    file(TO_CMAKE_PATH $ENV{RISCV_ROOT_PATH} RISCV_ROOT_PATH)
+    set(RISCV_ROOT_PATH ${RISCV_ROOT_PATH} CACHE STRING "root path to riscv toolchain")
+    set(CMAKE_C_COMPILER   ${RISCV_ROOT_PATH}/bin/riscv64-unknown-linux-gnu-gcc)
+    set(CMAKE_CXX_COMPILER ${RISCV_ROOT_PATH}/bin/riscv64-unknown-linux-gnu-g++)
+    set(CMAKE_STRIP        ${RISCV_ROOT_PATH}/bin/riscv64-unknown-linux-gnu-strip)
+    set(CMAKE_FIND_ROOT_PATH "${RISCV_ROOT_PATH}/riscv64-unknown-linux-gnu")
+    set(CMAKE_SYSROOT "${RISCV_ROOT_PATH}/sysroot")
+else()
+    set(RISCV_TOOLCHAIN_SUFFIX "" CACHE STRING "suffix of the riscv64-linux-gnu toolchain, e.g. -14")
+    set(CMAKE_C_COMPILER   riscv64-linux-gnu-gcc${RISCV_TOOLCHAIN_SUFFIX})
+    set(CMAKE_CXX_COMPILER riscv64-linux-gnu-g++${RISCV_TOOLCHAIN_SUFFIX})
+    set(CMAKE_STRIP        riscv64-linux-gnu-strip)
+    set(CMAKE_FIND_ROOT_PATH "/usr/lib/riscv64-linux-gnu")
+endif()
+
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
+
+# The MIPS vendor extensions (Xmipscmov, Xmipslsp, Xmipscbop) are documented by
+# LLVM as targeting the P8700 and are modelled by QEMU's `mips-p8700` CPU, but
+# are not accepted by every toolchain. Append them via MIPS_P8700_MARCH_EXTRA
+# when using a toolchain that supports them, e.g.
+#   -DMIPS_P8700_MARCH_EXTRA=_xmipscmov_xmipslsp_xmipscbop
+set(MIPS_P8700_MARCH_EXTRA "" CACHE STRING "extra -march components for the P8700")
+
+set(MIPS_P8700_MARCH "rv64gc_zba_zbb${MIPS_P8700_MARCH_EXTRA}")
+
+set(CMAKE_C_FLAGS   "-march=${MIPS_P8700_MARCH} -mabi=lp64d ${CMAKE_C_FLAGS}")
+set(CMAKE_CXX_FLAGS "-march=${MIPS_P8700_MARCH} -mabi=lp64d ${CMAKE_CXX_FLAGS}")
+set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -latomic")
